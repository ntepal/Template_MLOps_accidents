PROJECT_NAME=accidents_severity
EVIDENTLY_PATH=/app/data/evidently
EVIDENTLY_WORKSPACE=/app/data/evidently/accidents_severity-ws
LOG_LEVEL=INFO
MONITOR_DAEMON_TIMER=30
# --------------------------------------------------------------------------
# DO_NOT_TRACK=1 : désactive la télémétrie Evidently (analytics envoyés vers
# un serveur externe à chaque appel d'API).
# En Kubernetes, le pod n'a pas d'accès réseau sortant : l'appel log_event()
# du handler /api/projects échoue => HTTP 500 ("Something went wrong").
# Invisible en docker-compose (le conteneur avait l'accès internet de la VM).
# --------------------------------------------------------------------------
DO_NOT_TRACK=1
