PROJECT_NAME=accidents_severity
EVIDENTLY_PATH=/app/data/evidently
EVIDENTLY_WORKSPACE=/app/data/evidently/accidents_severity-ws
LOG_LEVEL=INFO
MONITOR_DAEMON_TIMER=30
# DO_NOT_TRACK=1 : desactive la telemetrie Evidently (analytics externes).
# En Kubernetes, pas d'acces reseau sortant : log_event() du handler
# /api/projects echoue => HTTP 500. Invisible en docker-compose.
DO_NOT_TRACK=1
