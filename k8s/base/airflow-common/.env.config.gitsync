# On clone la branche mlops_accidents_k3s du repo github
GIT_SYNC_REPO=https://github.com/ntepal/Template_MLOps_accidents.git
GIT_SYNC_BRANCH=mlops_accidents_k3s
# nom du dossier en local sur la VM = /GIT_SYNC_ROOT/GIT_SYNC_DEST = le contenu de mlops_accidents_k3s
# Le répertoire de travail (la racine) est /git (défini ci-dessous dans volumeMounts)
# Donc GIT_SYNC_ROOT/GIT_SYNC_DEST contient le contenu de la branche GIT_SYNC_BRANCH
# Indispensable en cas de multi-branche car ainsi, chaque repo a son contexte protégé
# Sans le repo, les contextes peuvent se percuter et générer des conflits
# Mais même utile avec un seul repo pour avoir la logique de l'arborescence
GIT_SYNC_ROOT=/git
GIT_SYNC_DEST=mlops_accidents_k3s
# Resynchronise toutes les x secondes
GIT_SYNC_WAIT=30
