apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: cadvisor
  labels:
    app: cadvisor

spec:
  selector:
    matchLabels:
      app: cadvisor

  template:
    metadata:
      labels:
        app: cadvisor

    spec:
      containers:
        - name: cadvisor
          image: gcr.io/cadvisor/cadvisor:v0.49.1
          imagePullPolicy: IfNotPresent

          ports:
            - containerPort: 8080

          # sans le security, cAdvisor ne fonctionne PAS correctement
          securityContext:
            privileged: true

          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10

          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 15

          volumeMounts:
            - name: rootfs
              mountPath: /rootfs
              readOnly: true

            - name: var-run
              mountPath: /var/run
              readOnly: true

            - name: sys
              mountPath: /sys
              readOnly: true

            - name: docker
              mountPath: /var/lib/docker
              readOnly: true

            - name: disk
              mountPath: /dev/disk
              readOnly: true

            - name: cgroup
              mountPath: /sys/fs/cgroup
              readOnly: true

      volumes:
        - name: rootfs
          hostPath:
            path: /

        - name: var-run
          hostPath:
            path: /var/run

        - name: sys
          hostPath:
            path: /sys

        - name: docker
          hostPath:
            path: /var/lib/docker

        - name: disk
          hostPath:
            path: /dev/disk

        - name: cgroup
          hostPath:
            path: /sys/fs/cgroup
