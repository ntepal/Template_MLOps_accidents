# Dans kubernetes, pas de logique (if, else), pas de variables dynamiques ${VAR}
# pas de calcul, pas de templating runtime (sauf outils externes), pas de “shell execution”
# Donc une variable doit avoir une affectation fixe

MLFLOW_TRACKING_URI=http://mlflow:5000
UV_LINK_MODE=copy
GIT_PYTHON_REFRESH=quiet
DAGSHUB_REPO_NAME=Template_MLOps_accidents
DVC_NO_ANALYTICS=true
DVC_GLOBAL_CONFIG_DIR=/tmp
