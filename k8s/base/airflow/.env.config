# Dans kubernetes, pas de logique (if, else), pas de variables dynamiques ${VAR}
# pas de calcul, pas de templating runtime (sauf outils externes), pas de “shell execution”
# Donc une variable doit avoir une affectation fixe
# Bonne pratique : format KEY=VALUE.
# Les guillemets sont inutiles sauf si espaces ou caractères spéciaux.

# --- Global ---
PROJECT_NAME=accidents-severity
DOCKER_MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Mlflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=accidents-severity

# --- Airflow core ---
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__BASE_LOG_FOLDER=/opt/airflow/logs
# Sert à dire comment déterminer le hostname (variable HOSTNAME)
AIRFLOW__CORE__HOSTNAME_CALLABLE=socket.gethostname
# GIT_SYNC_DEST = mlops_accidents_k3s ce qui permet d'avoir la même arborescence que sur github
AIRFLOW__CORE__DAGS_FOLDER=/git/mlops_accidents_k3s/deployments/airflow/dags
AIRFLOW__CORE__PLUGINS_FOLDER=/git/mlops_accidents_k3s/deployments/airflow/plugins
# Relecture des dags toutes les 30s
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=30

# --- Database ---
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW_CONN_POSTGRES_DEFAULT=postgres://airflow:airflow@postgres:5432/airflow

# --- Celery / Redis ---
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@postgres:5432/airflow

# --- Webserver ---
AIRFLOW__WEBSERVER__ENABLE_PROXY_FIX=true
AIRFLOW__WEBSERVER__BASE_URL=http://localhost/airflow
AIRFLOW__WEBSERVER__RATELIMIT_STORAGE_URI=redis://redis:6379/0

# --- Webserver ---
# Via le Makefile, ces 2 variables sont mises dans le .env.secret avec la valeur affécté
# _AIRFLOW_WWW_USER_USERNAME: "${_AIRFLOW_WWW_USER_USERNAME:-admin}"
# _AIRFLOW_WWW_USER_PASSWORD: "${_AIRFLOW_WWW_USER_PASSWORD:-admin}"

# --- API ---
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session

# --- DVC ---
DVC_REMOTE=origin

# --- DAGSHUG ---
# DAGSHUB_REPO_NAME: ${DAGSHUB_REPO_NAME}
DAGSHUB_REPO_NAME=Template_MLOps_accidents
AWS_ENDPOINT_URL=https://dagshub.com/s3

# --- MLFLOW DU DAGSHUB ---
# Via le Makefile, ces 2 variables sont mises dans le .env.secret avec la valeur affécté
# MLFLOW_TRACKING_USERNAME: ${DAGSHUB_USER}
# MLFLOW_TRACKING_PASSWORD: ${DAGSHUB_S3_SECRET_ACCESS_KEY}
